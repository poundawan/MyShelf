// Prisma schema for MyShelf — plateforme d'échange ludique
// Jeux de société / jeux de rôle / cartes à collectionner, clubs, tables (événements)

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameCategory {
  BOARD_GAME
  ROLE_PLAYING
  OTHER
}

enum Locale {
  FR
  EN
}

enum PlayerLevel {
  BEGINNER
  INTERMEDIATE
  CONFIRMED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  WORN
}

enum CopyStatus {
  ON_TABLE
  KEPT_WARM
  IN_TRADE
  TRADED
}

enum CardRarity {
  COMMON
  RARE
  FOIL
  MYTHIC
}

enum EventType {
  BOARD_GAME
  ROLE_PLAYING
  TCG
  DISCOVERY
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

enum TradeKind {
  GAME
  CARD
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TradeSide {
  FROM
  TO
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  name            String
  /// Libellé affiché. Toujours recopié du nom de la commune quand il y en a
  /// une : `communeCode` fait foi pour tout ce qui touche à la distance.
  city            String
  communeCode     String?
  commune         Commune?    @relation(fields: [communeCode], references: [code], onDelete: SetNull)
  avatarUrl       String?
  bio             String?
  verified        Boolean     @default(false)
  experienceLevel PlayerLevel @default(INTERMEDIATE)
  /// Langue d'affichage choisie par la personne.
  locale          Locale      @default(FR)
  createdAt       DateTime    @default(now())

  gameCopies          GameCopy[]
  gameWants           GameWant[]
  cardCopies          CardCopy[]
  cardWants           CardWant[]
  clubMemberships     ClubMembership[]
  hostedEvents        Event[]
  eventParticipations EventParticipant[]
  tradesSent          TradeProposal[]    @relation("TradesSent")
  tradesReceived      TradeProposal[]    @relation("TradesReceived")
  reviewsGiven        Review[]           @relation("ReviewsGiven")
  reviewsReceived     Review[]           @relation("ReviewsReceived")
  conversationsA      Conversation[]     @relation("ConversationUserA")
  conversationsB      Conversation[]     @relation("ConversationUserB")
  messages            Message[]
  notifications       Notification[]
  loginAttempts       LoginAttempt[]
  photos              Photo[]

  @@index([communeCode])
}

model Game {
  id            String       @id @default(cuid())
  title         String
  category      GameCategory
  level         PlayerLevel? // difficulté du jeu
  minPlayers    Int?
  maxPlayers    Int?
  durationMin   Int?
  minAge        Int?
  description   String?
  photoUrl      String?
  /// Fiche BoardGameGeek d'origine, quand le jeu a été repris de leur catalogue.
  /// Unique : deux personnes qui importent le même jeu partagent la même fiche.
  bggId         Int?         @unique
  /// Titre sous lequel BoardGameGeek catalogue le jeu — « Ticket to Ride »
  /// quand `title` dit « Les Aventuriers du Rail ».
  ///
  /// Conservé pour que deux personnes qui ajoutent le même jeu sous des noms
  /// différents tombent sur la même fiche du catalogue partagé. L'API, elle,
  /// n'en a pas besoin : elle ne connaît que `bggId`.
  titreOriginal String?
  createdAt     DateTime     @default(now())

  copies  GameCopy[]
  wants   GameWant[]
  reviews Review[]

  @@index([category])
}

model GameCopy {
  id        String        @id @default(cuid())
  gameId    String
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  condition ItemCondition
  status    CopyStatus    @default(ON_TABLE)
  createdAt DateTime      @default(now())

  tradeItems TradeItem[]

  @@index([gameId])
  @@index([ownerId])
}

model Card {
  id        String     @id @default(cuid())
  name      String
  setName   String?
  rarity    CardRarity @default(COMMON)
  photoUrl  String?
  createdAt DateTime   @default(now())

  copies CardCopy[]
  wants  CardWant[]
}

model CardCopy {
  id        String     @id @default(cuid())
  cardId    String
  card      Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status    CopyStatus @default(ON_TABLE)
  createdAt DateTime   @default(now())

  tradeItems TradeItem[]

  @@index([cardId])
  @@index([ownerId])
}

model CardWant {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cardId, userId])
  @@index([userId])
}

model GameWant {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gameId, userId])
  @@index([userId])
}

model Club {
  id          String   @id @default(cuid())
  name        String
  city        String
  communeCode String?
  commune     Commune? @relation(fields: [communeCode], references: [code], onDelete: SetNull)
  description String?
  createdAt   DateTime @default(now())

  memberships ClubMembership[]
  events      Event[]

  @@index([communeCode])
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([userId])
}

model Event {
  id              String      @id @default(cuid())
  hostId          String
  host            User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  clubId          String?
  club            Club?       @relation(fields: [clubId], references: [id], onDelete: SetNull)
  title           String
  type            EventType
  /// Langues dans lesquelles la table peut se jouer.
  languages       Locale[]    @default([FR])
  level           PlayerLevel @default(BEGINNER)
  description     String?
  bringList       String?
  city            String
  communeCode     String?
  commune         Commune?    @relation(fields: [communeCode], references: [code], onDelete: SetNull)
  location        String?
  photoUrl        String?
  startAt         DateTime
  endAt           DateTime?
  maxParticipants Int?
  status          EventStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  participants EventParticipant[]
  reviews      Review[]

  @@index([city])
  @@index([communeCode])
  @@index([startAt])
  @@index([hostId])
}

model EventParticipant {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model TradeProposal {
  id             String        @id @default(cuid())
  kind           TradeKind
  fromUserId     String
  fromUser       User          @relation("TradesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId       String
  toUser         User          @relation("TradesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         TradeStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items   TradeItem[]
  reviews Review[]

  @@index([fromUserId])
  @@index([toUserId])
}

model TradeItem {
  id              String        @id @default(cuid())
  tradeProposalId String
  tradeProposal   TradeProposal @relation(fields: [tradeProposalId], references: [id], onDelete: Cascade)
  gameCopyId      String?
  gameCopy        GameCopy?     @relation(fields: [gameCopyId], references: [id], onDelete: Cascade)
  cardCopyId      String?
  cardCopy        CardCopy?     @relation(fields: [cardCopyId], references: [id], onDelete: Cascade)
  offeredBy       TradeSide

  @@index([tradeProposalId])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  trades   TradeProposal[]

  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Review {
  id         String         @id @default(cuid())
  fromUserId String
  fromUser   User           @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User           @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  gameId     String?
  game       Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  tradeId    String?
  trade      TradeProposal? @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  context    String // ex. "Échange · Trois Comtés", "Cartes · Cendres du Nord"
  rating     Int
  comment    String
  createdAt  DateTime       @default(now())

  @@unique([fromUserId, tradeId])
  @@unique([fromUserId, eventId])
  @@index([toUserId])
}

enum NotificationKind {
  TRADE_PROPOSED
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_COMPLETED
  MESSAGE_RECEIVED
  EVENT_JOINED
  EVENT_CANCELLED
  REVIEW_RECEIVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  /// Clé de traduction, pas du texte : le destinataire peut lire dans une
  /// autre langue que celle de la personne qui a déclenché la notification.
  title     String
  body      String?
  /// Variables à insérer dans les clés ci-dessus (un prénom, un titre de table).
  params    Json?
  /// Où la notification emmène quand on clique dessus.
  href      String
  /// Regroupe les notifications d'une même source (un échange, une
  /// conversation) pour éviter d'en empiler dix pour le même fil.
  subjectId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Tentatives de connexion, pour limiter les essais par force brute.
/// `email` est conservé même sans compte correspondant : sinon on ne pourrait
/// pas freiner quelqu'un qui balaie des adresses au hasard.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/// Une image envoyée par un membre : avatar, salle d'une table, jaquette d'un jeu.
///
/// Les octets sont en base plutôt que sur un disque : Vercel n'a pas de système
/// de fichiers persistant, et une dépendance de stockage externe ne serait
/// vérifiable ni par les tests ni en développement. Le volume reste modeste,
/// les images étant réduites avant l'envoi.
model Photo {
  id       String @id @default(cuid())
  mimeType String
  bytes    Bytes
  byteSize Int
  width    Int
  height   Int

  /// Qui l'a envoyée. `SetNull` : la suppression d'un compte ne doit pas faire
  /// disparaître la jaquette d'un jeu du catalogue partagé.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([uploadedById])
}

/// Commune : le référentiel qui donne un sens aux distances.
///
/// France, plus les pays francophones voisins (Belgique, Suisse, Luxembourg,
/// Monaco). Le nom du modèle reste « Commune » par habitude française ; il
/// désigne en réalité une localité, quel que soit le pays.
///
/// Il est embarqué dans le dépôt (`prisma/data/communes.json.gz`, construit par
/// `scripts/construire-communes.ts`) plutôt qu'interrogé chez un tiers. Trois
/// raisons : aucune clé d'API ni quota à gérer, aucun service extérieur à qui
/// confier l'adresse de nos membres, et un comportement identique en
/// développement, dans les tests et en production.
///
/// La position stockée est celle du **centre de la commune**, jamais celle de
/// la personne : afficher des distances entre membres à partir de coordonnées
/// exactes permettrait de retrouver leur domicile par recoupement.
model Commune {
  /// Identifiant stable. Pour la France, le code INSEE nu (« 69266 », « 2A004 »).
  /// Ailleurs, il est préfixé du pays (« be-8693 ») : les deux espaces de
  /// nommage ne peuvent ainsi pas se télescoper, et les codes français
  /// existants n'ont pas eu à changer.
  code         String  @id
  /// Code ISO du pays, sur deux lettres.
  pays         String  @default("FR")
  nom          String
  /// Le nom sans accent ni trait d'union, en minuscules. C'est sur cette forme
  /// que porte la recherche, pour que « saint etienne » trouve « Saint-Étienne ».
  nomRecherche String
  codePostal   String?
  /// Subdivision administrative : département en France, canton en Suisse,
  /// province en Belgique. Distingue les nombreux homonymes à l'affichage.
  departement  String
  latitude     Float
  longitude    Float

  users  User[]
  events Event[]
  clubs  Club[]

  @@index([nomRecherche])
  @@index([pays])
  /// Sert au préfiltre par boîte englobante des recherches par rayon.
  @@index([latitude, longitude])
}
