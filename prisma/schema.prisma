// Prisma schema for MyShelf — plateforme d'échange ludique
// Jeux de société / jeux de rôle / cartes à collectionner, clubs, tables (événements)

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameCategory {
  BOARD_GAME
  ROLE_PLAYING
  OTHER
}

enum Locale {
  FR
  EN
}

enum PlayerLevel {
  BEGINNER
  INTERMEDIATE
  CONFIRMED
}

enum ItemCondition {
  NEW
  LIKE_NEW
  GOOD
  WORN
}

enum CopyStatus {
  ON_TABLE
  KEPT_WARM
  IN_TRADE
  TRADED
}

enum CardRarity {
  COMMON
  RARE
  FOIL
  MYTHIC
}

enum EventType {
  BOARD_GAME
  ROLE_PLAYING
  TCG
  DISCOVERY
}

enum EventStatus {
  ACTIVE
  CANCELLED
}

enum TradeKind {
  GAME
  CARD
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum TradeSide {
  FROM
  TO
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  name            String
  city            String
  avatarUrl       String?
  bio             String?
  verified        Boolean     @default(false)
  experienceLevel PlayerLevel @default(INTERMEDIATE)
  /// Langue d'affichage choisie par la personne.
  locale          Locale      @default(FR)
  createdAt       DateTime    @default(now())

  gameCopies          GameCopy[]
  gameWants           GameWant[]
  cardCopies          CardCopy[]
  cardWants           CardWant[]
  clubMemberships     ClubMembership[]
  hostedEvents        Event[]
  eventParticipations EventParticipant[]
  tradesSent          TradeProposal[]    @relation("TradesSent")
  tradesReceived      TradeProposal[]    @relation("TradesReceived")
  reviewsGiven        Review[]           @relation("ReviewsGiven")
  reviewsReceived     Review[]           @relation("ReviewsReceived")
  conversationsA      Conversation[]     @relation("ConversationUserA")
  conversationsB      Conversation[]     @relation("ConversationUserB")
  messages            Message[]
  notifications       Notification[]
  loginAttempts       LoginAttempt[]
}

model Game {
  id          String       @id @default(cuid())
  title       String
  category    GameCategory
  level       PlayerLevel? // difficulté du jeu
  minPlayers  Int?
  maxPlayers  Int?
  durationMin Int?
  minAge      Int?
  description String?
  photoUrl    String?
  createdAt   DateTime     @default(now())

  copies  GameCopy[]
  wants   GameWant[]
  reviews Review[]

  @@index([category])
}

model GameCopy {
  id        String        @id @default(cuid())
  gameId    String
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  condition ItemCondition
  status    CopyStatus    @default(ON_TABLE)
  createdAt DateTime      @default(now())

  tradeItems TradeItem[]

  @@index([gameId])
  @@index([ownerId])
}

model Card {
  id        String     @id @default(cuid())
  name      String
  setName   String?
  rarity    CardRarity @default(COMMON)
  photoUrl  String?
  createdAt DateTime   @default(now())

  copies CardCopy[]
  wants  CardWant[]
}

model CardCopy {
  id        String     @id @default(cuid())
  cardId    String
  card      Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status    CopyStatus @default(ON_TABLE)
  createdAt DateTime   @default(now())

  tradeItems TradeItem[]

  @@index([cardId])
  @@index([ownerId])
}

model CardWant {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cardId, userId])
  @@index([userId])
}

model GameWant {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([gameId, userId])
  @@index([userId])
}

model Club {
  id          String   @id @default(cuid())
  name        String
  city        String
  description String?
  createdAt   DateTime @default(now())

  memberships ClubMembership[]
  events      Event[]
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([userId])
}

model Event {
  id              String      @id @default(cuid())
  hostId          String
  host            User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  clubId          String?
  club            Club?       @relation(fields: [clubId], references: [id], onDelete: SetNull)
  title           String
  type            EventType
  /// Langues dans lesquelles la table peut se jouer.
  languages       Locale[]    @default([FR])
  level           PlayerLevel @default(BEGINNER)
  description     String?
  bringList       String?
  city            String
  location        String?
  photoUrl        String?
  startAt         DateTime
  endAt           DateTime?
  maxParticipants Int?
  status          EventStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  participants EventParticipant[]
  reviews      Review[]

  @@index([city])
  @@index([startAt])
  @@index([hostId])
}

model EventParticipant {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model TradeProposal {
  id             String        @id @default(cuid())
  kind           TradeKind
  fromUserId     String
  fromUser       User          @relation("TradesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId       String
  toUser         User          @relation("TradesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         TradeStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items   TradeItem[]
  reviews Review[]

  @@index([fromUserId])
  @@index([toUserId])
}

model TradeItem {
  id              String        @id @default(cuid())
  tradeProposalId String
  tradeProposal   TradeProposal @relation(fields: [tradeProposalId], references: [id], onDelete: Cascade)
  gameCopyId      String?
  gameCopy        GameCopy?     @relation(fields: [gameCopyId], references: [id], onDelete: Cascade)
  cardCopyId      String?
  cardCopy        CardCopy?     @relation(fields: [cardCopyId], references: [id], onDelete: Cascade)
  offeredBy       TradeSide

  @@index([tradeProposalId])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  trades   TradeProposal[]

  @@unique([userAId, userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Review {
  id         String         @id @default(cuid())
  fromUserId String
  fromUser   User           @relation("ReviewsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User           @relation("ReviewsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  gameId     String?
  game       Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  tradeId    String?
  trade      TradeProposal? @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  eventId    String?
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  context    String // ex. "Échange · Trois Comtés", "Cartes · Cendres du Nord"
  rating     Int
  comment    String
  createdAt  DateTime       @default(now())

  @@unique([fromUserId, tradeId])
  @@unique([fromUserId, eventId])
  @@index([toUserId])
}

enum NotificationKind {
  TRADE_PROPOSED
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_COMPLETED
  MESSAGE_RECEIVED
  EVENT_JOINED
  EVENT_CANCELLED
  REVIEW_RECEIVED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  /// Clé de traduction, pas du texte : le destinataire peut lire dans une
  /// autre langue que celle de la personne qui a déclenché la notification.
  title     String
  body      String?
  /// Variables à insérer dans les clés ci-dessus (un prénom, un titre de table).
  params    Json?
  /// Où la notification emmène quand on clique dessus.
  href      String
  /// Regroupe les notifications d'une même source (un échange, une
  /// conversation) pour éviter d'en empiler dix pour le même fil.
  subjectId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Tentatives de connexion, pour limiter les essais par force brute.
/// `email` est conservé même sans compte correspondant : sinon on ne pourrait
/// pas freiner quelqu'un qui balaie des adresses au hasard.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
