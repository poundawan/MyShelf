# Copie ce fichier en .env et adapte les valeurs.

# Base Postgres (ex. Supabase). Dans Supabase : Project Settings → Database.
# DATABASE_URL = connexion "Transaction pooler" (port 6543, pgbouncer=true) —
# utilisée par l'app au runtime (compatible serverless/Vercel).
# DIRECT_URL   = connexion directe (port 5432) — utilisée uniquement par les
# migrations Prisma (le pooler ne supporte pas les prepared statements).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Secret utilisé pour signer les cookies de session — génère une valeur
# aléatoire forte en production, ex. avec `openssl rand -base64 32`.
AUTH_SECRET="change-me"

# Jeton d'application BoardGameGeek, pour l'import des fiches de jeux.
# Leur API XML exige une inscription depuis le 2 juillet 2025 : sans jeton,
# tout appel reçoit un 401. Demande-le sur
# https://boardgamegeek.com/using_the_xml_api
# Laisse vide : l'application désactivera proprement le sélecteur, le reste
# du formulaire fonctionne à la main.
BGG_API_TOKEN=""

# Logo « Powered by BGG », exigé par leurs conditions pour toute application
# publique. Télécharge-le depuis la même page, dépose-le dans public/, puis
# indique son chemin ici. Laissé vide, la mention s'affiche en toutes lettres.
NEXT_PUBLIC_BGG_LOGO_URL=""

# Géocodage des communes (Géoplateforme / IGN). Laissé vide, l'application
# utilise https://data.geopf.fr/geocodage — inutile d'y toucher en temps
# normal. Sans réponse du service, elle retombe sur le référentiel embarqué.
ADRESSE_API_BASE=""
