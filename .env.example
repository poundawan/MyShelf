# Copie ce fichier en .env et adapte les valeurs.

# Chemin de la base SQLite. Utilise un chemin absolu en dev pour éviter les
# incohérences de résolution entre la CLI Prisma et le runtime Next.js.
DATABASE_URL="file:/absolute/path/to/project/prisma/dev.db"

# Secret utilisé pour signer les cookies de session — génère une valeur
# aléatoire forte en production, ex. avec `openssl rand -base64 32`.
AUTH_SECRET="change-me"
